POSTGRES_DB=internship_management
POSTGRES_USER=internship_user
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://internship_user:change_this_local_password@postgres:5432/internship_management?schema=public

# Authentication uses opaque database sessions, not JWT.
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
